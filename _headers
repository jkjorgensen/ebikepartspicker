# PWA: the service worker must always revalidate so updates apply;
# the manifest changes rarely, cache it briefly.
/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: public, max-age=3600

# Cache static assets longer. HTML stays at the Pages default
# (max-age=0, must-revalidate) so deploys show up immediately.
# CSS/JS already use ?v= cache-busting. Bike photos use ?v=IMGV.
# Part photos are often unversioned, so they revalidate weekly.
/img/bikes/*
  Cache-Control: public, max-age=31536000, immutable

/img/parts/*
  Cache-Control: public, max-age=604800, must-revalidate

/img/og/*
  Cache-Control: public, max-age=604800, must-revalidate

/img/*
  Cache-Control: public, max-age=604800, must-revalidate

/*.js
  Cache-Control: public, max-age=604800, must-revalidate

/*.css
  Cache-Control: public, max-age=604800, must-revalidate

# Unversioned /data.js must revalidate immediately so deploys are not
# stuck behind a 7-day CDN cache (index.html already uses data.js?v=).
/data.js
  Cache-Control: public, max-age=0, must-revalidate

/search-index.json
  Cache-Control: public, max-age=86400, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate

/*
  Link: <https://fonts.googleapis.com>; rel=preconnect
  Link: <https://fonts.gstatic.com>; rel=preconnect; crossorigin
